<!--index.wxml-->
<view class="container">
  <!-- 聊天消息区域 -->
  <scroll-view class="chat-container" scroll-y="true" scroll-into-view="{{scrollToView}}" scroll-with-animation="true">
    <view class="welcome-msg">
      <text class="welcome-text">您好，我是人工智能助手魔镜</text>
      <text class="welcome-sub">请问我有什么可以帮助您的吗？</text>
    </view>
    
    <view class="message-list">
      <block wx:for="{{messages}}" wx:key="id">
        <view class="message-item {{item.isUser ? 'user-message' : 'ai-message'}}" id="msg-{{item.id}}">
          <view class="message-avatar">
            <text class="avatar-text">{{item.isUser ? '您' : 'AI'}}</text>
          </view>
          <view class="message-content">
            <text class="message-text">{{item.content}}</text>
          </view>
        </view>
      </block>
    </view>
  </scroll-view>

  <!-- 输入框区域 -->
  <view class="input-container">
    <input class="chat-input" 
           value="{{inputValue}}" 
           placeholder="请输入..." 
           bindinput="onInput"
           confirm-type="send"
           bindconfirm="sendMessage"/>
    <button class="send-btn" bindtap="sendMessage" disabled="{{!inputValue}}">发送</button>
  </view>
</view>
